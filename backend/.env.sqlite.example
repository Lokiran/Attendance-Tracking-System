# Local development profile using SQLite. Select it explicitly:
#   $env:ATS_ENV_FILE = ".env.sqlite"     (or run scripts\run-local-sqlite.ps1)
# Copy to backend/.env.sqlite. Never used unless ATS_ENV_FILE selects it.
# For deployments and PostgreSQL verification use backend/.env.example instead.
APP_ENV=development

# Relative paths are resolved against the backend/ folder (not the current directory).
# The app never creates this file implicitly; initialise it with `alembic upgrade head`.
DATABASE_URL=sqlite:///data/ats-dev.sqlite3

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it stable so sign-in sessions survive backend restarts.
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

OFFICE_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173

# Demo seed (development only); also the sign-in passwords of seeded demo users.
SEED_ADMIN_EMAIL=admin@nexa.example
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
