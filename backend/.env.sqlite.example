# Local development profile using SQLite. Select it explicitly:
#   $env:ATS_ENV_FILE = ".env.sqlite"     (or run scripts\run-local-sqlite.ps1)
# Copy to backend/.env.sqlite. Never used unless ATS_ENV_FILE selects it.
# For deployments and PostgreSQL verification use backend/.env.example instead.
APP_ENV=development

# Relative paths are resolved against the backend/ folder (not the current directory).
# The app never creates this file implicitly; initialise it with `alembic upgrade head`.
DATABASE_URL=sqlite:///data/ats-dev.sqlite3

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it stable so sign-in sessions survive backend restarts.
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

OFFICE_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173

# --- Sign-in ---
# Email/password login. Keep it on until Microsoft Entra ID sign-in is live, then set it to false.
PASSWORD_LOGIN_ENABLED=true

# Microsoft Entra ID (OIDC). Leave all four empty to disable; set all four to enable.
# App registration: platform "Web", redirect URI = ENTRA_REDIRECT_URI, ID tokens via the code flow,
# delegated scopes openid / profile / email. The secret comes from "Certificates & secrets".
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# The app's callback on the origin the browser uses (https in production), e.g.
# https://attendance.example.com/api/auth/entra/callback
# Development (through the Vite proxy): http://localhost:5173/api/auth/entra/callback
ENTRA_REDIRECT_URI=
# ENTRA_AUTHORITY=https://login.microsoftonline.com

# Local testing only: sign in as any active user by email without a password.
# Must stay false outside your laptop; the app refuses to start with it on when APP_ENV=production.
DEV_LOGIN_ENABLED=false

# Demo seed (development only); also the sign-in passwords of seeded demo users.
SEED_ADMIN_EMAIL=admin@nexa.example
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
