# Copy to backend/.env and fill in real values. Never commit backend/.env.
APP_ENV=development

# PostgreSQL connection (SQLAlchemy URL using the psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://ats:CHANGE_ME_DB_PASSWORD@localhost:5432/ats

# Used to HMAC session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (>= 32 chars) when APP_ENV=production.
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# Office timezone used for workday boundaries and display
OFFICE_TIMEZONE=Asia/Kolkata

# Session lifetime
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# Cookies: COOKIE_SECURE defaults to true in production, false otherwise
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Login throttling
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# --- Sign-in ---
# Email/password login. Keep it on until Microsoft Entra ID sign-in is live, then set it to false.
PASSWORD_LOGIN_ENABLED=true

# Microsoft Entra ID (OIDC). Leave all four empty to disable; set all four to enable.
# App registration: platform "Web", redirect URI = ENTRA_REDIRECT_URI, ID tokens via the code flow,
# delegated scopes openid / profile / email. The secret comes from "Certificates & secrets".
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# The app's callback on the origin the browser uses (https in production), e.g.
# https://attendance.example.com/api/auth/entra/callback
ENTRA_REDIRECT_URI=
# ENTRA_AUTHORITY=https://login.microsoftonline.com

# Local testing only: sign in as any active user by email without a password.
# Must stay false outside your laptop; the app refuses to start with it on when APP_ENV=production.
DEV_LOGIN_ENABLED=false

# --- Seeding (development only) ---
# The seed command refuses to run without these. Use strong values.
SEED_ADMIN_EMAIL=admin@nexa.example
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Optional: database used by the backend test-suite (it is wiped by the tests!)
# TEST_DATABASE_URL=postgresql+psycopg://ats:CHANGE_ME_DB_PASSWORD@localhost:5432/ats_test
