# Base path of the API as seen by the browser. Keep "/api" in development (Vite proxies it).
VITE_API_BASE_URL=/api
# Where the Vite dev server proxies /api to
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
# Polling interval for team/organisation dashboards in milliseconds (0 disables polling)
VITE_DASHBOARD_REFRESH_MS=30000
