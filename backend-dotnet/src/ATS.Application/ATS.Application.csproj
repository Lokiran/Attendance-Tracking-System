<Project Sdk="Microsoft.NET.Sdk">
  <!-- Services, DTOs, validators, settings and the Python-compatibility helpers. -->
  <PropertyGroup>
    <RootNamespace>Ats.Application</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared framework (DI, logging, options abstractions); not a NuGet package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ATS.Domain\ATS.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Services query through IAtsDb (DbSet / LINQ); the provider and DbContext live in Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="FluentValidation" />
    <!-- Timesheet files (Uploads/TimesheetFiles.cs). -->
    <PackageReference Include="ExcelDataReader" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>
  <ItemGroup>
    <!-- The bundled WFO mapping (a copy of backend/config/wfo_mapping.json); WFO_MAPPING_FILE replaces it. -->
    <Content Include="..\..\config\wfo_mapping.json" Link="config\wfo_mapping.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ATS.Tests" />
  </ItemGroup>
</Project>
