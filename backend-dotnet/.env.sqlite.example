# Local development profile with SQLite. Copy to backend-dotnet/.env.sqlite (gitignored) and select it with
#   $env:ATS_ENV_FILE = ".env.sqlite"     (in the PowerShell window that runs the API)
# Never commit real values.
APP_ENV=development

# Local SQLite file, relative to this file's directory. It must exist: create it once with
#   $env:ATS_ENV_FILE = ".env.sqlite"; dotnet run --project src\ATS.Api -- migrate
DATABASE_URL=sqlite:///data/ats-dev.sqlite3

# Random value of at least 32 characters in production (python -c "import secrets; print(secrets.token_urlsafe(48))").
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_VALUE

OFFICE_TIMEZONE=Asia/Kolkata
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
TRUST_PROXY_HEADERS=false
PASSWORD_LOGIN_ENABLED=true

# Microsoft Entra ID sign-in: all four or none.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# Local testing only; refused in production.
DEV_LOGIN_ENABLED=false

# Branding of the PDF / Excel exports (keep the logo file out of the repository).
REPORT_COMPANY_NAME=
REPORT_LOGO_FILE=
REPORT_BRAND_COLOR=
REPORT_ACCENT_COLOR=
LOG_LEVEL=INFO

# --- Management commands (development only) ---
# `seed` refuses to run without these (use strong values). `create-admin` prompts for a password unless
# ATS_ADMIN_PASSWORD is set; leave it empty here.
SEED_ADMIN_EMAIL=admin@nexa.example
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
ATS_ADMIN_PASSWORD=
