<Project>
  <!-- One version per package for the whole solution. Packages outside the approved stack need sign-off first
       (see docs/dotnet-migration-plan.md, section 9). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="API">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Auth and validation">
    <!-- Approved (decision D4): verifies the argon2-cffi PHC hashes already in the database. -->
    <PackageVersion Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <!-- Entra ID token validation (the library JwtBearer is built on; plan section 9). -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
  </ItemGroup>
  <ItemGroup Label="Timesheet import">
    <!-- Approved (decision D4): .xlsx / .xlsm / .xls cells (openpyxl and xlrd in Python). MIT. -->
    <PackageVersion Include="ExcelDataReader" Version="3.9.0" />
    <!-- Approved (decision D4, "UglyToad.PdfPig"; the NuGet id is PdfPig): PDF text with positions (pdfminer.six). Apache-2.0. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <ItemGroup Label="Reports">
    <!-- Approved (plan section 9): writes the xlsx exports (openpyxl in Python). MIT; its SixLabors.Fonts 1.0.0 is Apache-2.0. -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- 7.x is Apache-2.0; 8.x is commercial (decision D5). -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <!-- Approved (plan section 9): a throw-away PostgreSQL 16 in Docker for local runs (ATS_TEST_POSTGRES_CONTAINER=1). MIT. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>
</Project>
