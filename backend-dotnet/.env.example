# Settings for the .NET API. Same keys and meaning as backend/.env.example, so an existing backend/.env also works:
#   $env:ATS_ENV_FILE = "..\backend\.env"   (PowerShell; relative paths are resolved from backend-dotnet/)
# Copy to backend-dotnet/.env (gitignored) and fill in. Never commit real values.
APP_ENV=development

# Required. PostgreSQL:  postgresql+psycopg://ats:CHANGE_ME_DB_PASSWORD@localhost:5432/ats
#           SQLite:      sqlite:///data/ats-dev.sqlite3   (relative to this file's directory; the file must exist)
DATABASE_URL=postgresql+psycopg://ats:CHANGE_ME_DB_PASSWORD@localhost:5432/ats

# Random value of at least 32 characters in production (python -c "import secrets; print(secrets.token_urlsafe(48))").
# Use the same value as the Python backend to share sign-in sessions during parity testing.
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_VALUE

OFFICE_TIMEZONE=Asia/Kolkata
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
TRUST_PROXY_HEADERS=false
PASSWORD_LOGIN_ENABLED=true

# Microsoft Entra ID sign-in: all four or none.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# Local testing only; refused in production.
DEV_LOGIN_ENABLED=false

# Branding of the PDF / Excel exports (keep the logo file out of the repository).
REPORT_COMPANY_NAME=
REPORT_LOGO_FILE=
REPORT_BRAND_COLOR=
REPORT_ACCENT_COLOR=
LOG_LEVEL=INFO
